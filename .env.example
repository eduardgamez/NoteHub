# Browser-facing development configuration. The anon key is safe to expose only
# together with the row-level-security policies in supabase/migrations/.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# The API broker keeps provider secrets outside the browser bundle.
NOTEHUB_API_PORT=8787
NOTEHUB_WEB_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# Set true in public deployments. This validates the user's Supabase JWT.
NOTEHUB_REQUIRE_AUTH=false

# Configure one or more providers. The selected provider is chosen in Settings.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview
