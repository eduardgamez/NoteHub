# Browser-facing development configuration. The publishable key is safe to expose only
# together with the row-level-security policies in supabase/migrations/.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# The API broker keeps provider secrets outside the browser bundle.
NOTEHUB_API_PORT=8787
NOTEHUB_WEB_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# Set true in public deployments. This validates the user's Supabase JWT.
NOTEHUB_REQUIRE_AUTH=false

# Configure one or more providers. The selected provider is chosen in Settings.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Optional: path to the Codex executable if it is not on PATH or in VS Code.
NOTEHUB_CODEX_BIN=
# Optional: verified NoteHub emails allowed to use the Mac Codex session remotely.
# Empty keeps Codex local-only; never enable this without an explicit owner allowlist.
NOTEHUB_CODEX_REMOTE_EMAILS=

# Optional default AI broker URL for the installed iPhone app (also editable in Settings).
VITE_API_ORIGIN=
# Add capacitor://localhost to NOTEHUB_WEB_ORIGIN when using a custom origin allowlist.
